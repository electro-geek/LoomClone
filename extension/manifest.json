{
  "manifest_version": 3,
  "name": "Omnipotent — Screen Recorder",
  "version": "1.0.0",
  "description": "Record your screen, mic and webcam bubble. Everything stays local — no account, no upload, no backend.",
  "minimum_chrome_version": "116",
  "permissions": [
    "offscreen",
    "storage",
    "unlimitedStorage",
    "scripting",
    "tabs",
    "downloads"
  ],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Omnipotent",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_page": "library/library.html",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["overlay/*", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
