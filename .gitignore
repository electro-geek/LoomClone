# Omnipotent — a no-build Chrome extension with dependency-free Node tooling.
# (This replaced GitHub's Python template, which matched nothing in this repo.)

# ---------------------------------------------------------------- build output
# Chrome Web Store upload zips from tools/package.mjs
dist/

# ------------------------------------------------------------- video thumbnails
# Thumbnails for the LeetCode solution videos — personal assets, unrelated to
# the extension itself. To keep the HTML sources under version control and
# ignore only the rendered images, replace this line with:  thumbnails/*.png
thumbnails/

# --------------------------------------------------------------------- recordings
# Stray screen recordings and exports (the e2e test writes to the system temp
# directory, but keep the repo clean if anything lands here).
*.mp4
*.webm
*.mkv

# --------------------------------------------------------------------------- node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm/
.pnpm-store/
package-lock.json.bak

# ------------------------------------------------------------------------- local
# Environment and secrets — nothing here needs them today, but a published
# extension often grows a signing key or an upload token.
.env
.env.*
!.env.example
*.pem
*.key

# ------------------------------------------------------------------------ editors
.vscode/
.idea/
*.swp
*.swo
*~

# ------------------------------------------------------------------------- system
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# --------------------------------------------------------------------------- logs
*.log
logs/

# Note: extension/icons/*.png are generated by tools/make-icons.mjs but stay
# tracked on purpose — a fresh clone should load unpacked without a build step.
